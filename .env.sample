FFMPEG_LOG="1" # 1 for enable, 0 for disable

AWS_SECRET_ACCESS_KEY=""
AWS_ACCESS_KEY_ID=""
AWS_REGION=""

# sqs queue url
QUEUE_URL=""


# Cloudflare
CF_ACCOUNT_ID=
# R2 API token (S3-compatible access key)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# optional, local scratch dir for transcoding (default: $TMPDIR/streamcraft)
WORK_DIR=

# CloudAMQP connection URL (amqps://user:pass@host/vhost)
AMQP_URL=
